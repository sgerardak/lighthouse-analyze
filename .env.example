# Which LLM provider implementation to use.
LLM_PROVIDER=anthropic

# Required. Your Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model used for all LLM calls.
MODEL_NAME=claude-haiku-4-5-20251001

# Timeout for a single LLM call, in seconds.
LLM_TIMEOUT_SECONDS=20

# Overall timeout for an inbound HTTP request, in seconds.
REQUEST_TIMEOUT_SECONDS=45

# Maximum number of retry attempts for a failed LLM call.
MAX_RETRIES=3

# Maximum accepted length of a user query, in characters.
MAX_QUERY_LENGTH=2000
